{
  "name": "symph",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "netlify dev --filter @symph/web",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p netlify/functions --noEmit && tsc -p tsconfig.json",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts",
    "dev:trigger": "trigger dev",
    "deploy:trigger": "trigger deploy --env prod",
    "gen:banned": "node scripts/gen-banned-words.mjs",
    "rebuild:html": "esbuild scripts/rebuild-post-html.ts --bundle --platform=node --format=esm --target=node22 --outfile=scripts/.rebuild-post-html.mjs --log-level=error --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && node --env-file=.env scripts/.rebuild-post-html.mjs"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.8.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "trigger.dev": "^4.8.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@netlify/functions": "^6.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@trigger.dev/sdk": "^4.8.2",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  }
}
