{
  "name": "symph",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "netlify dev",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p netlify/functions --noEmit",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@netlify/functions": "^6.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  }
}
